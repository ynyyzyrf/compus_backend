# ===== Application =====
APP_ENV=development

# ===== Database =====
# docker compose exposes Postgres on localhost:5433 (host 5432 already in use)
DATABASE_URL=postgresql+psycopg://campus:campus_dev_pwd@localhost:5433/campus
TEST_DATABASE_URL=postgresql+psycopg://campus:campus_dev_pwd@localhost:5433/campus_test

# ===== Auth / JWT =====
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRE_MINUTES=10080

# ===== WeChat Mini Program =====
# Empty secret => rely on WECHAT_MOCK_LOGIN during local development.
WECHAT_APPID=wx42d74cdbd19566ff
WECHAT_SECRET=
# true: skip jscode2session, map login codes to seed users, enable /auth/dev-impersonate
WECHAT_MOCK_LOGIN=true

# ===== CORS =====
CORS_ORIGINS=http://localhost,http://localhost:5173

# ===== Dev local file storage =====
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage_data

# ===== Admin AI assistant =====
# Keep keys on the backend only. Leave empty to return a clear configuration
# error from /api/v1/admin/ai/chat while the rest of the app keeps working.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
