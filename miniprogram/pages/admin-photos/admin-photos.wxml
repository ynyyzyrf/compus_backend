<view class="page-pad">
  <view class="page-title">{{title}}</view>
  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />
  <t-empty wx:elif="{{rows.length === 0}}" description="{{empty}}" />

  <view wx:else class="review-list">
    <view wx:for="{{rows}}" wx:key="id" class="review-card">
      <image class="photo" src="{{item.file_url}}" mode="aspectFill" />
      <view class="info">
        <view class="name">Photo #{{item.id}}</view>
        <view class="muted">Activity #{{item.activity_id}}</view>
      </view>
      <view class="ops">
        <t-button size="small" theme="primary" data-id="{{item.id}}" loading="{{approvingId === item.id}}" bindtap="approve">{{approveText}}</t-button>
        <t-button size="small" theme="danger" variant="outline" data-id="{{item.id}}" loading="{{approvingId === item.id}}" bindtap="reject">{{rejectText}}</t-button>
      </view>
    </view>
  </view>
</view>
