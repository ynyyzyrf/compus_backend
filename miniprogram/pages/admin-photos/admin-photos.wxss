.page-title { font-size: 40rpx; font-weight: 900; margin-bottom: 24rpx; }
.review-list { display: flex; flex-direction: column; gap: 18rpx; }
.review-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 18rpx;
  box-shadow: var(--shadow);
}
.photo { width: 100%; height: 320rpx; border-radius: 16rpx; background: #eaf1fb; }
.info { margin-top: 16rpx; }
.name { font-weight: 800; color: var(--ink); }
.muted { color: var(--muted); font-size: 24rpx; margin-top: 6rpx; }
.ops { display: flex; gap: 16rpx; margin-top: 18rpx; }
