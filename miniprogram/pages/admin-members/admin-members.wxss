.search-wrap {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(20, 29, 38, 0.04);
}
.total { font-size: 24rpx; margin-bottom: 20rpx; }
.list { display: flex; flex-direction: column; gap: 20rpx; }
.item {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(20, 29, 38, 0.04);
}
.row1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.name { font-size: 30rpx; font-weight: 700; flex: 1; }
.small { font-size: 22rpx; }
.row2 { font-size: 24rpx; margin-bottom: 16rpx; }
.actions-row {
  display: flex;
  gap: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #edf0f2;
}
.action { font-size: 26rpx; color: #07c160; }
