<view class="page-pad">
  <view class="search-wrap">
    <t-input
      value="{{q}}"
      placeholder="搜索姓名/手機/微信/公司/職位"
      bind:change="onSearch"
      bind:confirm="onSearchSubmit"
    />
  </view>
  <view class="muted total">共 {{total}} 人</view>

  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />
  <t-empty wx:elif="{{items.length === 0}}" description="無數據" />

  <view wx:else class="list">
    <view class="item" wx:for="{{items}}" wx:key="id">
      <view class="row1">
        <text class="name">{{item.name}}</text>
        <t-tag wx:if="{{item.role === 'super_admin'}}" theme="primary" variant="light" size="small">超管</t-tag>
        <t-tag wx:if="{{item.status === 'disabled'}}" theme="warning" variant="light" size="small">已停用</t-tag>
        <text wx:else class="muted small">{{item.primary_org_path || '尚未分班'}}</text>
      </view>
      <view wx:if="{{item.position || item.company_name}}" class="muted row2">
        <text wx:if="{{item.position}}">{{item.position}}</text>
        <text wx:if="{{item.position && item.company_name}}"> · </text>
        <text wx:if="{{item.company_name}}">{{item.company_name}}</text>
      </view>
      <view class="actions-row">
        <view class="action" data-id="{{item.id}}" bindtap="onEdit">編輯</view>
        <view class="action" data-id="{{item.id}}" bindtap="onToggleStatus">
          {{item.status === 'active' ? '停用' : '啟用'}}
        </view>
      </view>
    </view>
  </view>
</view>
