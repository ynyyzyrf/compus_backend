<wxs src="../../utils/i18n.wxs" module="t" />
<view class="page-pad">
  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />

  <t-empty wx:elif="{{!article}}" description="{{t.t('articles.detail_empty', lang)}}" />

  <block wx:elif="{{article}}">
    <view class="card">
      <view class="meta">
        <text class="type">{{typeLabel}}</text>
        <text wx:if="{{article.is_pinned}}" class="pin">{{t.t('articles.pinned', lang)}}</text>
        <text wx:if="{{dateText}}" class="date">{{dateText}}</text>
      </view>
      <view class="title">{{article.title}}</view>
      <view wx:if="{{article.summary}}" class="summary">{{article.summary}}</view>
      <view class="content">{{article.content}}</view>
    </view>
  </block>
</view>
