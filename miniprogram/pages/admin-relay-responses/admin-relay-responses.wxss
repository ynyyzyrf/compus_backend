.list { display: flex; flex-direction: column; gap: 20rpx; margin-top: 24rpx; }
.item {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow);
}
.user { font-size: 30rpx; font-weight: 900; margin-bottom: 14rpx; }
.line { display: flex; gap: 20rpx; padding: 10rpx 0; border-top: 1rpx solid var(--line); }
.label { width: 180rpx; color: var(--muted); flex: 0 0 auto; font-size: 25rpx; }
.value { flex: 1; color: var(--ink); font-size: 26rpx; word-break: break-all; }
