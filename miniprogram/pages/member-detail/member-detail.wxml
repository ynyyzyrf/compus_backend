<wxs src="../../utils/i18n.wxs" module="t" />
<view class="page-pad">
  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />

  <t-empty wx:elif="{{!member}}" description="{{t.t('member.empty', lang)}}" />

  <block wx:elif="{{member}}">
    <view class="profile-card card">
      <image wx:if="{{member.avatar_url}}" class="avatar-img" src="{{member.avatar_url}}" mode="aspectFill" />
      <view wx:else class="avatar">{{member.initial}}</view>
      <view class="profile-main">
        <view class="name-line">
          <text class="name">{{member.name}}</text>
          <text wx:if="{{member.name_en}}" class="name-en">{{member.name_en}}</text>
        </view>
        <view class="org">{{member.org_path}}</view>
      </view>
    </view>

    <view class="quick-contact card">
      <view
        class="contact-box {{member.wechat_id ? '' : 'disabled'}}"
        data-value="{{member.wechat_id}}"
        bindtap="copyText"
      >
        <view class="contact-icon green">微</view>
        <text>{{t.t('member.wechat', lang)}}</text>
      </view>
      <view
        class="contact-box {{member.phone ? '' : 'disabled'}}"
        data-value="{{member.phone}}"
        bindtap="copyText"
      >
        <view class="contact-icon blue">電</view>
        <text>{{t.t('member.phone', lang)}}</text>
      </view>
      <view
        class="contact-box {{member.email ? '' : 'disabled'}}"
        data-value="{{member.email}}"
        bindtap="copyText"
      >
        <view class="contact-icon mail">郵</view>
        <text>{{t.t('member.email', lang)}}</text>
      </view>
    </view>

    <view wx:if="{{member.contactRows.length}}" class="info-card card">
      <view class="card-title">{{t.t('member.contact', lang)}}</view>
      <view class="info-row" wx:for="{{member.contactRows}}" wx:key="label">
        <text class="label">{{item.label}}</text>
        <text class="value" data-value="{{item.value}}" bindtap="copyText">{{item.value}}</text>
      </view>
    </view>

    <view wx:if="{{member.companyRows.length}}" class="info-card card">
      <view class="card-title">{{t.t('member.company', lang)}}</view>
      <view class="info-row" wx:for="{{member.companyRows}}" wx:key="label">
        <text class="label">{{item.label}}</text>
        <text class="value">{{item.value}}</text>
      </view>
    </view>

    <view wx:if="{{member.storyRows.length}}" class="info-card card">
      <view class="card-title">{{t.t('member.business_card', lang)}}</view>
      <view class="story-row" wx:for="{{member.storyRows}}" wx:key="label">
        <text class="story-label">{{item.label}}</text>
        <text class="story-value">{{item.value}}</text>
      </view>
    </view>

    <view wx:if="{{member.chamberRows.length}}" class="info-card card">
      <view class="card-title">{{t.t('member.chamber', lang)}}</view>
      <view class="info-row" wx:for="{{member.chamberRows}}" wx:key="label">
        <text class="label">{{item.label}}</text>
        <text class="value">{{item.value}}</text>
      </view>
    </view>
  </block>
</view>
