.thread { height: 100vh; display: flex; flex-direction: column; background: var(--bg); }
.thread-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 24rpx; border-bottom: 1rpx solid var(--line); }
.thread-toolbar button, .thread-compose button { margin: 0; color: var(--brand); white-space: nowrap; }
.thread-history { flex: 1; height: 0; min-height: 0; }
.thread-note { padding: 36rpx 24rpx; text-align: center; color: var(--muted); }
.older-messages { display: block; margin: 20rpx auto 0; }
.message-row { display: flex; flex-direction: column; align-items: flex-start; gap: 8rpx; padding: 16rpx 24rpx; }
.message-row.own { align-items: flex-end; }
.message-time { font-size: 21rpx; color: var(--muted); }
.message-text { max-width: 82%; padding: 16rpx 22rpx; background: var(--card); border: 1rpx solid var(--line); border-radius: 14rpx; white-space: pre-wrap; overflow-wrap: anywhere; }
.message-row.own .message-text { background: var(--brand-soft); }
.thread-compose { display: flex; align-items: flex-end; gap: 16rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: var(--card); }
.thread-compose textarea { flex: 1; min-width: 0; min-height: 42rpx; max-height: 180rpx; padding: 12rpx 14rpx; background: var(--bg); border-radius: 10rpx; }
