.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.subtitle {
  color: var(--muted);
  font-size: 25rpx;
  margin-top: -8rpx;
}
.scope-tag {
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  flex: 0 0 auto;
}
.scope-line {
  margin: 16rpx 0 0;
}
.search-wrap {
  height: 76rpx;
  padding: 0 22rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(126, 40, 34, 0.05);
  display: flex;
  align-items: center;
  gap: 14rpx;
  overflow: hidden;
}
.search-mark {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 800;
  flex: 0 0 auto;
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  color: var(--ink);
  font-size: 26rpx;
}
.search-clear {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #eef2f7;
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  flex: 0 0 auto;
}
.chips {
  white-space: nowrap;
  margin: 20rpx 0 8rpx;
}
.chip {
  display: inline-block;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  color: var(--muted);
  font-weight: 600;
}
.chip-on {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  border-color: var(--brand);
  color: #fff;
}
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 4rpx 16rpx;
}
.list-head .t {
  font-weight: 700;
  font-size: 30rpx;
}
.members {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.member {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  padding: 24rpx;
  box-shadow: var(--shadow);
  transition: transform 0.16s ease;
}
.member:active {
  transform: scale(0.985);
}
.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff4e1, #f1d698);
  color: var(--brand);
  font-weight: 800;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}
.meta {
  flex: 1;
  min-width: 0;
}
.name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
}
.tag {
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-weight: 700;
}
.org {
  font-size: 24rpx;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.contact {
  color: var(--subtle);
  width: 40rpx;
  font-size: 40rpx;
  line-height: 1;
  display: flex;
  justify-content: flex-end;
}
