.directory-page,
.directory-banner,
.banner-heading,
.search-wrap,
.directory-categories,
.directory-category,
.list-head,
.members,
.member {
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
}
.directory-banner,
.search-wrap,
.members,
.member {
  width: 100%;
}
.banner-copy {
  min-width: 0;
  flex: 1;
}
.directory-banner {
  margin-bottom: 18rpx;
  padding: 24rpx 24rpx 12rpx;
  border-radius: 24rpx;
  background: var(--brand-2);
  color: var(--card);
}
.banner-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.banner-label {
  color: var(--gold-soft);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.banner-title {
  margin-top: 4rpx;
  font-size: 36rpx;
  font-weight: 700;
}
.banner-icon {
  flex: none;
  color: var(--gold-soft);
}
.directory-categories {
  display: flex;
  margin-top: 4rpx;
}
.directory-category {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding-bottom: 6rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  white-space: nowrap;
}
.directory-category.current {
  color: var(--card);
  font-weight: 700;
}
.category-indicator {
  position: absolute;
  bottom: 14rpx;
  width: 30rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: var(--card);
}
.search-wrap {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  gap: 12rpx;
  padding-left: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
}
.search-icon,
.search-button,
.search-submit,
.member-action,
.member-arrow {
  color: var(--brand);
}
.search-icon,
.member-arrow {
  flex: none;
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  color: var(--ink);
  font-size: 26rpx;
}
.search-placeholder {
  color: var(--muted);
}
.search-button,
.search-clear {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  align-self: stretch;
}
.search-button {
  padding: 0 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.search-clear {
  width: 52rpx;
  color: var(--muted);
}
.search-submit {
  display: inline-block;
  padding: 12rpx 0;
  font-size: 26rpx;
}
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  margin-top: 12rpx;
}
.list-title {
  font-size: 30rpx;
  font-weight: 700;
}
.list-count {
  flex: none;
  margin-left: 16rpx;
  white-space: nowrap;
  color: var(--muted);
  font-size: 24rpx;
}
.member {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 128rpx;
  padding: 20rpx 0;
}
.member + .member {
  border-top: 1rpx solid var(--line);
}
.member-pressed {
  background: var(--bg);
}
.avatar {
  display: block;
  flex: none;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
}
.meta {
  flex: 1;
  min-width: 0;
}
.name,
.org {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.name {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}
.org {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 24rpx;
}
.member-action {
  display: flex;
  align-items: center;
  flex: none;
  min-height: 72rpx;
  font-size: 25rpx;
}
