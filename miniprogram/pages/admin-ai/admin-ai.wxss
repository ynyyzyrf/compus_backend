.ai-page {
  min-height: 100vh;
  background: #f7f7f8;
  box-sizing: border-box;
}

.chat-scroll {
  height: calc(100vh - 132rpx);
}

.chat-inner {
  padding: 34rpx 32rpx 42rpx;
  box-sizing: border-box;
}

.page-title {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--text);
  margin-bottom: 28rpx;
}

.quick-row {
  display: flex;
  gap: 18rpx;
  overflow-x: auto;
  white-space: nowrap;
  margin-bottom: 22rpx;
}

.quick-chip {
  flex: 0 0 auto;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #dfdfe6;
  background: #fff;
  color: var(--text);
  font-size: 27rpx;
  line-height: 72rpx;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.message-row {
  display: flex;
  width: 100%;
}

.message-row.assistant {
  justify-content: flex-start;
}

.message-row.user {
  justify-content: flex-end;
}

.message-bubble {
  max-width: 82%;
  padding: 24rpx 28rpx;
  border-radius: 26rpx;
  font-size: 30rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  box-sizing: border-box;
  box-shadow: 0 18rpx 42rpx rgba(31, 35, 45, 0.08);
}

.message-row.assistant .message-bubble {
  background: #fff;
  color: var(--text);
  border-bottom-left-radius: 8rpx;
}

.message-row.user .message-bubble {
  background: linear-gradient(135deg, #b7352c, #cfad49);
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.message-bubble.loading {
  color: var(--muted);
}

.chat-bottom {
  height: 10rpx;
}

.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(247, 247, 248, 0.96);
  border-top: 1rpx solid #dedfe5;
  box-sizing: border-box;
}

.chat-input {
  flex: 1;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 2rpx solid #e1e2e8;
  box-sizing: border-box;
  font-size: 28rpx;
}

.send-button {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #b7352c, #cfad49);
  color: #fff;
  font-size: 44rpx;
  line-height: 82rpx;
  text-align: center;
  font-weight: 800;
  box-shadow: 0 16rpx 34rpx rgba(183, 53, 44, 0.24);
}

.send-button.disabled {
  opacity: 0.55;
}
