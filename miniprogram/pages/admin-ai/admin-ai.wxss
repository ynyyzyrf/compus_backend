.page-title { font-size: 40rpx; font-weight: 900; margin-bottom: 24rpx; }
.panel,
.answer {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow);
  margin-bottom: 22rpx;
}
.ask {
  width: 100%;
  height: 260rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fff9f1;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.answer-text { white-space: pre-wrap; line-height: 1.7; font-size: 28rpx; }
.muted { color: var(--muted); font-size: 26rpx; }
