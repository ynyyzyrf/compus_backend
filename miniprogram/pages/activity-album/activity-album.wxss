.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 26rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ink);
}
.muted {
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 6rpx;
}
.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}
.photo {
  width: 100%;
  height: 250rpx;
  border-radius: 18rpx;
  background: #eaf1fb;
  box-shadow: var(--shadow);
}
