<view class="page-pad">
  <view class="page-head">
    <view>
      <view class="page-title">{{copy.title}}</view>
      <view class="muted">{{photos.length}} photos</view>
    </view>
    <t-button theme="primary" size="small" loading="{{uploading}}" bindtap="onUpload">{{copy.upload}}</t-button>
  </view>

  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />
  <t-empty wx:elif="{{photos.length === 0}}" description="{{copy.empty}}" />

  <view wx:else class="photo-grid">
    <image wx:for="{{photos}}" wx:key="id" class="photo" src="{{item.file_url}}" mode="aspectFill" />
  </view>
</view>
