<view class="page-pad">
  <view class="head">
    <text class="title">组织架构</text>
    <view class="new-mini" bindtap="onAddRoot">＋ 学校</view>
  </view>
  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />
  <t-empty wx:elif="{{!items.length}}" description="暂无组织节点" />
  <view wx:else class="tree card">
    <view wx:for="{{items}}" wx:key="id" class="line {{'indent-' + item.depth}}">
      <view class="row">
        <t-tag theme="primary" variant="light" size="small">{{item.typeLabel}}</t-tag>
        <text class="name">{{item.name}}</text>
        <text wx:if="{{item.entry_year}}" class="muted small">{{item.entry_year}}级</text>
        <text wx:if="{{item.member_count}}" class="muted small">{{item.member_count}} 人</text>
        <text wx:if="{{item.status === 'disabled'}}" class="muted small">已停用</text>
      </view>
      <view class="actions">
        <view wx:if="{{item.type !== 'class' && item.status === 'active'}}" class="action" data-id="{{item.id}}" bindtap="onAddChild">
          ＋ {{item.type === 'school' ? '学院' : item.type === 'college' ? '系别' : item.type === 'department' ? '专业' : '班级'}}
        </view>
        <view wx:if="{{item.type === 'department' && item.status === 'active'}}" class="action" data-id="{{item.id}}" data-type="class" bindtap="onAddChild">＋ 班级</view>
        <view class="action" data-id="{{item.id}}" bindtap="onEdit">编辑</view>
        <view class="action danger" data-id="{{item.id}}" bindtap="onDelete">删除</view>
      </view>
    </view>
  </view>

  <view wx:if="{{sheet}}" class="sheet-mask" bindtap="closeSheet">
    <view class="sheet" catchtap="stopTap">
      <view class="grab"></view>
      <view class="sheet-title">{{sheetMode === 'create' ? '新增' : '编辑'}}{{typeLabel}}</view>
      <view wx:if="{{parentName}}" class="field">
        <view class="lbl">上级组织</view>
        <picker wx:if="{{parentChoices.length > 1}}" range="{{parentChoices}}" range-key="name" bindchange="onParent">
          <view class="readonly">{{parentName}} ›</view>
        </picker>
        <view wx:else class="readonly">{{parentName}}</view>
      </view>
      <view class="field">
        <view class="lbl">名称</view>
        <input class="readonly" value="{{form.name}}" maxlength="128" placeholder="{{form.type === 'class' ? '例如：2班' : '请输入名称'}}" bindinput="onNameChange" />
      </view>
      <view wx:if="{{form.type === 'class'}}" class="field">
        <view class="lbl">入学年份</view>
        <input class="readonly" type="number" value="{{form.year}}" maxlength="4" placeholder="例如：2018" bindinput="onYearChange" />
      </view>
      <view class="actions">
        <t-button theme="primary" size="large" block loading="{{saving}}" bindtap="onSave">保存</t-button>
      </view>
    </view>
  </view>
</view>
