<view class="page-pad">
  <view class="head">
    <text class="title">組織架構</text>
    <t-button theme="primary" size="small" bindtap="onAddRoot">＋ 新建頂層</t-button>
  </view>

  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />

  <view wx:else class="tree card">
    <view wx:for="{{items}}" wx:key="id" class="line {{'indent-' + (item.type === 'school' ? 0 : item.type === 'college' ? 1 : item.type === 'department' ? 2 : 3)}}">
      <view class="row">
        <t-tag theme="primary" variant="light" size="small">{{item.typeLabel}}</t-tag>
        <text class="name">{{item.name}}</text>
        <text wx:if="{{item.member_count > 0}}" class="muted small">{{item.member_count}} 人</text>
        <text wx:if="{{item.status === 'disabled'}}" class="muted small">(已停用)</text>
      </view>
      <view class="actions">
        <view wx:if="{{item.type !== 'class'}}" class="action" data-id="{{item.id}}" bindtap="onAddChild">＋子節點</view>
        <view class="action" data-id="{{item.id}}" bindtap="onRename">改名</view>
        <view class="action danger" data-id="{{item.id}}" bindtap="onDelete">刪除</view>
      </view>
    </view>
  </view>

  <view wx:if="{{sheet}}" class="sheet-mask" bindtap="closeSheet">
    <view class="sheet" catchtap="">
      <view class="grab"></view>
      <view class="sheet-title">{{sheetMode === 'create' ? '新建節點' : '重命名'}}</view>

      <view class="field">
        <view class="lbl">名稱</view>
        <t-input value="{{form.name}}" placeholder="節點名稱" bind:change="onNameChange" />
      </view>

      <view wx:if="{{sheetMode === 'create'}}" class="field">
        <view class="lbl">類型</view>
        <view class="muted small">父節點類型決定可選類型</view>
        <view class="readonly">{{form.type}}</view>
      </view>

      <view wx:if="{{sheetMode === 'create' && parents.length > 0}}" class="field">
        <view class="lbl">父節點</view>
        <t-checkbox-group value="{{form.parent_id ? [form.parent_id] : []}}" bind:change="onParentChange">
          <view wx:for="{{parents}}" wx:key="id" class="scope-row">
            <t-checkbox value="{{item.id}}" label="{{item.name}} ({{item.typeLabel}})" />
          </view>
        </t-checkbox-group>
      </view>

      <view class="actions">
        <t-button theme="primary" size="large" block bindtap="onSave">保存</t-button>
      </view>
    </view>
  </view>
</view>
