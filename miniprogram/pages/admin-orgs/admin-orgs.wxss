.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.title { font-size: 44rpx; font-weight: 800; }
.new-mini {
  min-width: 132rpx;
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: var(--brand);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}
.empty-create {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.new-center {
  min-width: 240rpx;
  height: 72rpx;
  padding: 0 34rpx;
  border-radius: 18rpx;
  background: var(--brand);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(185, 39, 34, 0.2);
}
.tree { padding: 16rpx 20rpx; }
.line {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}
.line:last-child { border-bottom: 0; }
.indent-0 { padding-left: 0; }
.indent-1 { padding-left: 32rpx; }
.indent-2 { padding-left: 64rpx; }
.indent-3 { padding-left: 96rpx; }
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.name { font-size: 28rpx; font-weight: 700; flex: 1; }
.small { font-size: 22rpx; }
.actions { display: flex; gap: 16rpx; margin-top: 8rpx; padding-left: 20rpx; }
.action { font-size: 24rpx; color: #07c160; }
.action.danger { color: #f04b4b; }

/* sheet */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(12, 16, 20, 0.45);
  z-index: 60;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 32rpx 40rpx;
  max-height: 80vh;
  overflow: auto;
}
.grab {
  width: 80rpx;
  height: 8rpx;
  background: #dce1e5;
  border-radius: 999rpx;
  margin: 0 auto 24rpx;
}
.sheet-title { font-size: 32rpx; font-weight: 800; margin-bottom: 24rpx; }
.field { margin-bottom: 24rpx; }
.lbl { font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx; }
.scope-row { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 0; }
.small { font-size: 24rpx; color: #77808a; }
.readonly { font-size: 28rpx; color: #182027; padding: 12rpx 0; }
.actions { margin-top: 32rpx; }
