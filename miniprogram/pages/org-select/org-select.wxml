<view class="page-pad">
  <view wx:if="{{loading}}" class="card">载入中...</view>
  <view wx:elif="{{error}}" class="card"><text>{{error}}</text><button bindtap="load">重试</button></view>
  <view wx:elif="{{pendingPath}}" class="card">
    <view class="title">等待管理员审核</view>
    <view class="path">{{pendingPath}}</view>
    <view class="muted">审核通过后即可查看所属组织的通讯录。</view>
    <button class="primary" bindtap="enterHome">进入首页</button>
  </view>
  <view wx:else>
    <view class="card">
      <view class="title">找回组织</view>
      <input class="choice" maxlength="80" value="{{keyword}}" placeholder="搜索学校、年份、专业或班级" bindinput="search" />
      <academic-filters classes="{{classes}}" show-school="{{true}}" bind:select="onFilter" />
      <view class="muted">{{searchCount}} 个班级</view>
      <view wx:for="{{shown}}" wx:key="id" class="class-option {{chosen.id === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="choose">
        <text>{{item.label}}</text>
        <view class="muted">{{item.path}}</view>
      </view>
      <button wx:if="{{searchCount > shown.length}}" size="mini" bindtap="showMore">查看更多班级</button>
      <view class="link" bindtap="report">找不到我的班级</view>
    </view>
    <view wx:if="{{chosen}}" class="card confirmation" id="confirm-class">
      <view class="label">确认班级</view>
      <view class="path">{{chosen.path}}</view>
      <view class="label">姓名</view>
      <input class="choice name-input" maxlength="64" value="{{name}}" placeholder="请输入真实姓名" bindinput="onNameInput" />
      <button class="primary" loading="{{submitting}}" bindtap="submit">提交归属申请</button>
    </view>
    <view class="link muted" bindtap="enterHome">先逛逛首页</view>
  </view>
  <view class="sign-out" bindtap="signOut">退出登录</view>
</view>
