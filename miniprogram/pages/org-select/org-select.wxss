.intro .title, .card .title { font-size: 36rpx; font-weight: 800; margin-bottom: 14rpx; }
.label { font-weight: 700; margin: 24rpx 0 12rpx; }
.choice { min-height: 88rpx; padding: 24rpx; background: #f6f8fc; border-radius: 16rpx; }
.path { font-size: 30rpx; margin: 20rpx 0; line-height: 1.5; }
.primary { margin-top: 38rpx; background: var(--brand); color: white; border-radius: 16rpx; }
.sign-out { text-align: center; color: var(--muted); padding: 24rpx; }
