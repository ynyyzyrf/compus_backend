<view class="page-pad">
  <view class="card">
    <view class="label">标题</view>
    <t-input value="{{form.title}}" placeholder="活动名称" bind:change="onTitle" maxlength="200" />
  </view>

  <view class="card">
    <view class="label">地点</view>
    <t-input value="{{form.location}}" placeholder="活动地点" bind:change="onLocation" maxlength="200" />
    <view class="sub-label">主办方</view>
    <t-input value="{{form.organizer}}" placeholder="校友会 / 公司" bind:change="onOrganizer" maxlength="200" />
    <view class="sub-label">封面图 URL</view>
    <t-input value="{{form.cover_url}}" placeholder="可选，留空用默认" bind:change="onCover" />
    <view class="sub-label">人数上限</view>
    <t-input value="{{form.capacity}}" type="number" placeholder="留空 = 不限" bind:change="onCapacity" />
  </view>

  <view class="card">
    <view class="label">活动时间</view>
    <view class="sub-label">开始</view>
    <t-input value="{{form.start_at}}" placeholder="YYYY-MM-DDTHH:mm" bind:change="onStart" />
    <view class="sub-label">结束</view>
    <t-input value="{{form.end_at}}" placeholder="YYYY-MM-DDTHH:mm" bind:change="onEnd" />
  </view>

  <view class="card">
    <view class="label">报名时间</view>
    <view class="sub-label">报名开始</view>
    <t-input value="{{form.signup_start_at}}" placeholder="YYYY-MM-DDTHH:mm" bind:change="onSignupStart" />
    <view class="sub-label">报名截止</view>
    <t-input value="{{form.signup_end_at}}" placeholder="YYYY-MM-DDTHH:mm" bind:change="onSignupEnd" />
  </view>

  <view class="card">
    <view class="label">活动介绍</view>
    <t-textarea
      value="{{form.description}}"
      placeholder="活动内容、流程、注意事项"
      bind:change="onDesc"
      maxlength="2000"
      disable-default-padding="{{true}}"
      autosize="{{true}}"
    />
  </view>

  <view class="actions">
    <t-button theme="primary" size="large" loading="{{saving}}" block bindtap="onSave">保存</t-button>
  </view>
</view>
