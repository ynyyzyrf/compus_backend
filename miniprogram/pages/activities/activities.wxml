<wxs src="../../utils/i18n.wxs" module="t" />
<view class="page-pad">
  <scroll-view scroll-x class="pill-scroll" enhanced show-scrollbar="{{false}}">
    <view class="pill-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="pill-tab {{current === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTabTap"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />

  <t-empty wx:elif="{{activities.length === 0}}" description="{{t.t('common.empty', lang)}}" />

  <view wx:else class="activity-list">
    <view class="activity-card" wx:for="{{activities}}" wx:key="id" data-id="{{item.id}}" bindtap="onCardTap">
      <view class="image-wrap">
        <image class="cover" src="{{item.cover_url || '/assets/campus-hero.jpg'}}" mode="aspectFill" />
        <view class="date-badge">
          <text class="month">{{item.month}}</text>
          <text class="day">{{item.day}}</text>
        </view>
      </view>
      <view class="body">
        <view class="title">{{item.title}}</view>
        <view class="row"><t-icon name="time" size="28rpx" />{{item.timeText}}</view>
        <view class="row"><t-icon name="location" size="28rpx" />{{item.location}}</view>
        <view class="footer">
          <view class="signup-summary">
            <text>{{item.countText}}</text>
            <text wx:if="{{item.remainingText}}" class="remaining">{{item.remainingText}}</text>
          </view>
          <view class="status {{item.statusClass}}" data-id="{{item.id}}" catchtap="onSignup">{{item.statusText}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
