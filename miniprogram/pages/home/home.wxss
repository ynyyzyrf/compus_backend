.home-page {
  padding-top: 24rpx;
}

.home-banner {
  display: block;
  width: 100%;
  height: 330rpx;
  margin-bottom: 20rpx;
  border-radius: 26rpx;
}

.home-shortcuts {
  display: flex;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
}

.home-shortcut {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 104rpx;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 650;
}

.home-shortcut + .home-shortcut {
  border-left: 1rpx solid var(--line);
}

.home-shortcut-icon {
  color: var(--brand);
}

.home-shortcut .home-chevron {
  margin-left: auto;
}

.home-chevron {
  flex: none;
  color: var(--muted);
}

.home-pinned {
  margin-top: 20rpx;
  background: var(--card);
  border-left: 4rpx solid var(--gold);
  border-radius: 8rpx;
}

.home-pin-label {
  flex: none;
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 600;
}

.home-pin-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-section {
  margin-top: 32rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line);
}

.home-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
}

.home-section-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 650;
}

.home-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-height: 88rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.home-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 92rpx;
  padding: 18rpx 0;
}

.home-list .home-row + .home-row {
  border-top: 1rpx solid var(--line);
}

.home-pinned.home-row {
  padding: 20rpx 24rpx;
}

.home-row-pressed {
  background: var(--bg);
}

.home-thumb {
  display: block;
  flex: none;
  width: 130rpx;
  height: 92rpx;
  border-radius: 8rpx;
}

.home-activity-preview {
  width: 164rpx;
  height: 116rpx;
  border-radius: 12rpx;
}

.home-article-with-cover .home-thumb {
  width: 220rpx;
  height: 156rpx;
  border-radius: 12rpx;
}

.home-article-with-cover .home-row-body {
  display: flex;
  align-self: stretch;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.home-row-body {
  flex: 1;
  min-width: 0;
}

.home-row-title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.home-meta {
  overflow: hidden;
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-row-end {
  display: flex;
  flex: none;
  align-items: center;
  gap: 4rpx;
  white-space: nowrap;
}

.home-status {
  color: var(--muted);
  font-size: 23rpx;
}

.home-status-active {
  color: var(--brand);
  font-weight: 600;
}

.home-invite,
.home-inline-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 88rpx;
  margin-top: 20rpx;
  padding: 14rpx 24rpx;
  background: var(--card);
  border-radius: 12rpx;
  color: var(--brand);
  font-size: 26rpx;
}

.home-invite text {
  padding: 12rpx 0;
}

.home-invite-later,
.home-empty {
  color: var(--muted);
}

.home-empty {
  padding: 52rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
}
