.topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.brand {
  font-size: 42rpx;
  font-weight: 900;
  color: var(--ink);
}
.brand-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}
.top-actions {
  width: 72rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
}
.more-dot {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 2rpx;
}
.hero {
  position: relative;
  height: 330rpx;
  border-radius: 26rpx;
  color: #fff;
  overflow: hidden;
  box-shadow: 0 18rpx 44rpx rgba(185, 39, 34, 0.18);
}
.hero-img,
.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
.hero-mask {
  background: linear-gradient(90deg, rgba(8, 21, 42, 0.78), rgba(8, 21, 42, 0.16) 76%);
}
.hero-copy {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 30rpx;
  z-index: 1;
}
.eyebrow {
  font-size: 20rpx;
  opacity: 0.85;
  font-weight: 700;
}
.hello {
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 900;
  margin: 12rpx 0 10rpx;
  letter-spacing: 0;
}
.desc {
  font-size: 26rpx;
  opacity: 0.92;
}
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  row-gap: 30rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 32rpx 12rpx 28rpx;
  margin-top: 28rpx;
  box-shadow: var(--shadow);
}
.quick {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 600;
}
.qicon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  box-shadow: 0 12rpx 24rpx rgba(185, 39, 34, 0.12);
}
.glyph {
  color: #fff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
}
.qicon.cyan { background: linear-gradient(135deg, #d7aa44, #b68529); }
.qicon.blue { background: linear-gradient(135deg, #c83a34, #8f1f1a); }
.qicon.amber { background: linear-gradient(135deg, #f0cf83, #d7aa44); }
.qicon.orange { background: linear-gradient(135deg, #d96a43, #b92722); }
.qicon.mint { background: linear-gradient(135deg, #d7b45c, #b8872d); }
.qicon.sky { background: linear-gradient(135deg, #c95b4f, #a52622); }
.activity-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 150rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 18rpx;
  box-shadow: var(--shadow);
}
.activity-thumb {
  width: 142rpx;
  height: 112rpx;
  border-radius: 18rpx;
  flex: 0 0 auto;
}
.activity-meta {
  flex: 1;
  min-width: 0;
}
.activity-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.activity-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--muted);
}
.mini-label {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 800;
  flex: 0 0 auto;
}
.activity-cta {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  height: 46rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #fff;
  display: flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 700;
}
.news-list {
  padding: 12rpx 24rpx;
}
.news-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.news-row:last-child {
  border-bottom: 0;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--amber);
  flex: 0 0 auto;
}
.blue-dot {
  background: var(--brand);
}
.news-copy {
  flex: 1;
  min-width: 0;
}
.news-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.news-date {
  margin-top: 6rpx;
  color: var(--subtle);
  font-size: 23rpx;
}
