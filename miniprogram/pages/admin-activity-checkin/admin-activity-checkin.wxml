<view class="page-pad">
  <view class="card qr-card">
    <view class="muted small">请让用户用小程序扫一扫扫描下方签到码</view>
    <view class="qr-box">
      <view class="qr-placeholder">
        <view class="big-icon">📱</view>
        <view class="muted tiny">活动 #{{activityId}}</view>
        <view class="muted tiny">到期: {{expiresAtText}}</view>
      </view>
    </view>
    <view class="token-label">签到 token（粘贴到小程序的签到输入框）</view>
    <view class="token-box">{{token || '生成中...'}}</view>
  </view>

  <view class="actions">
    <t-button theme="primary" size="large" block bindtap="copyToken">复制 token</t-button>
    <t-button theme="default" variant="outline" size="large" block bindtap="refresh">刷新签到码</t-button>
  </view>
  <view class="muted hint">每次刷新生成新 token（旧的 8 小时内仍可使用）。下一步切片会用 canvas 渲染真正的二维码。</view>
</view>
