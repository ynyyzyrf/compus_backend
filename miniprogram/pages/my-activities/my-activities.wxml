<wxs src="../../utils/i18n.wxs" module="t" />
<view class="page-pad">
  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />

  <t-empty wx:elif="{{items.length === 0}}" description="{{t.t('activities.my_empty', lang)}}" />

  <view wx:else class="activity-list">
    <view class="activity-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onCardTap">
      <image class="cover" src="{{item.cover_url || '/assets/campus-hero.jpg'}}" mode="aspectFill" />
      <view class="body">
        <view class="title">{{item.title}}</view>
        <view class="row"><t-icon name="time" size="28rpx" />{{item.timeText}}</view>
        <view class="row"><t-icon name="location" size="28rpx" />{{item.location}}</view>
        <view class="footer">
          <view class="signup-summary">{{item.countText}}</view>
          <view class="status {{item.statusClass}}">{{item.statusText}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
