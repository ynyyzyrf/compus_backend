.tabs-bar {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(126, 40, 34, 0.05);
}
.list { display: flex; flex-direction: column; gap: 18rpx; }
.item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  padding: 18rpx;
  box-shadow: var(--shadow);
}
.item.pinned { border-left: 8rpx solid var(--brand); }
.thumb {
  width: 128rpx;
  height: 112rpx;
  border-radius: 18rpx;
  flex: 0 0 auto;
}
.content {
  flex: 1;
  min-width: 0;
}
.row1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.type {
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border: 1rpx solid rgba(185, 39, 34, 0.18);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex: 0 0 auto;
  font-weight: 700;
}
.title {
  display: block;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.title-strong { color: var(--brand); }
.summary {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
