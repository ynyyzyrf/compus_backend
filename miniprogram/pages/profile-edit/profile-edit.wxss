.title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
  color: var(--ink);
}
.label {
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
  color: var(--ink);
}
.label-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}
.field { margin-bottom: 24rpx; }
.native-input {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #f6f8fc;
  color: var(--ink);
  font-size: 30rpx;
  margin-bottom: 24rpx;
}
.readonly {
  font-size: 30rpx;
  color: var(--ink);
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #f6f8fc;
}
.actions {
  position: sticky;
  bottom: 20rpx;
  margin-top: 40rpx;
  padding: 16rpx 0;
}
