<wxs src="../../utils/i18n.wxs" module="t" />
<view class="page-pad">
  <text class="page-title">{{t.t('relays.title', lang)}}</text>

  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />
  <t-empty wx:elif="{{items.length === 0}}" description="{{t.t('relays.empty', lang)}}" />

  <view wx:else class="list">
    <view class="relay-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="row1">
        <text class="title">{{item.title}}</text>
        <t-tag theme="{{item.status === 'open' ? 'success' : 'default'}}" variant="light" size="small">{{item.statusText}}</t-tag>
      </view>
      <view wx:if="{{item.description}}" class="desc">{{item.description}}</view>
      <view class="meta">
        <text>{{item.responseText}}</text>
        <text wx:if="{{item.deadlineText}}">{{t.t('relays.deadline', lang)}} {{item.deadlineText}}</text>
      </view>
    </view>
  </view>
</view>
