.list { display: flex; flex-direction: column; gap: 18rpx; margin-top: 24rpx; }
.relay-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  padding: 26rpx;
  box-shadow: var(--shadow);
}
.row1 { display: flex; align-items: center; gap: 16rpx; }
.title {
  flex: 1;
  min-width: 0;
  font-size: 31rpx;
  font-weight: 800;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.desc {
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.55;
  margin-top: 12rpx;
}
.meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 18rpx;
}
