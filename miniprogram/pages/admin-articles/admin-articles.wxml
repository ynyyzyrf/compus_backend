<view class="page-pad">
  <view class="head">
    <text class="title">文章管理</text>
    <view wx:if="{{items.length > 0}}" class="new-mini" bindtap="onNew">＋ 新建</view>
  </view>

  <t-tabs value="{{current}}" bind:change="onTabChange">
    <t-tab-panel
      wx:for="{{tabs}}"
      wx:key="key"
      label="{{item.label}}"
      value="{{index}}"
    />
  </t-tabs>

  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />
  <view wx:elif="{{items.length === 0}}" class="empty-create">
    <t-empty description="暂无文章" />
    <view class="new-center" bindtap="onNew">＋ 新建文章</view>
  </view>

  <view wx:else class="list">
    <view class="item" wx:for="{{items}}" wx:key="id">
      <view class="row1">
        <text class="title2 {{item.is_pinned ? 'title-strong' : ''}}">{{item.title}}</text>
        <t-tag
          wx:if="{{item.status !== 'published'}}"
          theme="warning"
          variant="light"
          size="small"
        >{{item.status === 'draft' ? '草稿' : '已下架'}}</t-tag>
        <t-tag
          wx:if="{{item.is_pinned}}"
          theme="success"
          variant="light"
          size="small"
        >置顶</t-tag>
      </view>
      <view class="row2 muted">
        <text>{{item.type === 'news' ? '新闻' : item.type === 'announcement' ? '公告' : '通知'}}</text>
        <text>范围: {{item.scope_ids && item.scope_ids.length ? item.scope_ids.length + ' 个节点' : '全校可见'}}</text>
      </view>
      <view class="row3">
        <view class="action" data-id="{{item.id}}" bindtap="onEdit">编辑</view>
        <view class="action danger" data-id="{{item.id}}" bindtap="onDelete">删除</view>
      </view>
    </view>
  </view>
</view>
