.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.title { font-size: 44rpx; font-weight: 800; }
.new-mini {
  min-width: 132rpx;
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: var(--brand);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}
.empty-create {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.new-center {
  min-width: 240rpx;
  height: 72rpx;
  padding: 0 34rpx;
  border-radius: 18rpx;
  background: var(--brand);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(185, 39, 34, 0.2);
}
.list { display: flex; flex-direction: column; gap: 20rpx; }
.item {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
}
.title2 {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.row2 {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 12rpx 0;
  font-size: 24rpx;
}
.actions-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line);
}
.action { font-size: 26rpx; }
.action.danger { color: #f04b4b; margin-left: auto; }
