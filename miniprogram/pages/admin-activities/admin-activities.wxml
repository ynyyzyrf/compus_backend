<view class="page-pad">
  <view class="head">
    <text class="title">活動管理</text>
    <view wx:if="{{items.length > 0}}" class="new-mini" bindtap="onNew">＋ 新建</view>
  </view>

  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />
  <view wx:elif="{{items.length === 0}}" class="empty-create">
    <t-empty description="暫無活動" />
    <view class="new-center" bindtap="onNew">＋ 新建活動</view>
  </view>

  <view wx:else class="list">
    <view class="item" wx:for="{{items}}" wx:key="id">
      <view class="title2">{{item.title}}</view>
      <view class="muted">
        <text>{{item.start_at}}</text> · <text>{{item.location}}</text>
      </view>
      <view class="row2">
        <t-tag theme="primary" variant="light" size="small">{{item.status}}</t-tag>
        <text class="muted">報名 {{item.signup_count}} / 簽到 {{item.checkin_count}}</text>
      </view>
      <view class="actions-row">
        <view class="action" data-id="{{item.id}}" bindtap="onCheckinCode">簽到碼</view>
        <view class="action" data-id="{{item.id}}" bindtap="onRoster">名單</view>
        <view class="action" data-id="{{item.id}}" bindtap="onEdit">編輯</view>
        <view class="action danger" data-id="{{item.id}}" bindtap="onDelete">刪除</view>
      </view>
    </view>
  </view>
</view>
