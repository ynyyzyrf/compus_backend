<wxs src="../../utils/i18n.wxs" module="t" />
<view class="mine-page">
  <view class="profile-header {{affiliationText ? 'has-notice' : ''}}">
    <view wx:if="{{affiliationText}}" class="pending-notice">
      <view class="pending-notice-pill">
        <t-icon class="pending-notice-icon" name="sound-high-filled" size="30rpx" color="#FFE0A3" />
        <text class="pending-notice-title">组织申请审核中</text>
        <view class="pending-notice-divider" />
        <text class="pending-notice-path">{{affiliationText}}</text>
      </view>
    </view>
    <view class="profile-hero {{affiliationText ? 'has-notice' : ''}}">
      <view class="guest-login-hit {{isGuest ? 'active' : ''}}" bindtap="goLoginIfGuest">
        <image class="avatar big" src="{{user && user.avatar_url ? user.avatar_url : '/assets/default-avatar.png'}}" mode="aspectFill"
          data-id="{{user.id}}" data-src="{{user.avatar_url}}" binderror="onAvatarError" />
        <view class="hero-info">
          <view class="name-line">
            <text class="login-name">{{user ? user.name : (t.t('mine.login_now', lang))}}</text>
            <text wx:if="{{isAdmin || isClassAdmin}}" class="badge">{{isClassAdmin ? '班级管理员' : t.t('mine.admin_badge', lang)}}</text>
          </view>
          <view wx:if="{{heroSub}}" class="hero-sub">{{heroSub}}</view>
        </view>
      </view>
      <view class="profile-pill" bindtap="goProfileCard">{{t.t('mine.menu.profile', lang)}}</view>
    </view>
  </view>

  <view class="service-card">
    <view class="section-title">{{t.t('mine.service_title', lang)}}</view>
    <view class="service-grid">
      <view class="service-item" bindtap="goMyActivities">
        <view class="service-icon">活</view>
        <text>{{t.t('mine.menu.my_activities', lang)}}</text>
      </view>
      <view class="service-item" aria-role="button" aria-label="{{showRelayDot ? '我的接龙，有进行中的接龙' : '我的接龙'}}" bindtap="goRelays">
        <view class="service-icon">
          <text>表</text>
          <view wx:if="{{showRelayDot}}" class="service-dot" />
        </view>
        <text>{{t.t('mine.menu.my_relays', lang)}}</text>
      </view>
    </view>
  </view>

  <view class="menu-card">
    <view wx:if="{{connectionsEligible || unreadRequests || unreadMessages}}" class="menu-item" bindtap="goConnections">
      <text>好友与申请</text>
      <text wx:if="{{unreadRequests || unreadMessages}}" class="requests-count">{{unreadRequests + unreadMessages}}</text>
      <t-icon class="arrow muted" name="chevron-right" size="30rpx" />
    </view>
    <view wx:if="{{isAdmin}}" class="menu-item" bindtap="goAdminDashboard">
      <text>{{t.t('mine.admin_entry', lang)}}</text>
      <t-icon class="arrow muted" name="chevron-right" size="30rpx" />
    </view>
    <view wx:if="{{isClassAdmin}}" class="menu-item" bindtap="goAffiliationReview">
      <text>班级申请审核</text>
      <t-icon class="arrow muted" name="chevron-right" size="30rpx" />
    </view>
    <view wx:if="{{user && !isGuest}}" class="menu-item" bindtap="goSettings">
      <text>设置</text>
      <t-icon class="arrow muted" name="chevron-right" size="30rpx" />
    </view>
    <view class="menu-item" bindtap="comingSoon">
      <text>{{t.t('mine.contact_us', lang)}}</text>
      <t-icon class="arrow muted" name="chevron-right" size="30rpx" />
    </view>
    <view class="menu-item" bindtap="comingSoon">
      <text>{{t.t('mine.agreement', lang)}}</text>
      <t-icon class="arrow muted" name="chevron-right" size="30rpx" />
    </view>
  </view>

  <view wx:if="{{isDev}}" class="dev card">
    <view class="dev-title">{{t.t('mine.dev_title', lang)}}</view>
    <view class="muted dev-tip">{{t.t('mine.dev_tip', lang)}}</view>
    <view class="dev-users">
      <view
        wx:for="{{devUsers}}"
        wx:key="id"
        class="dev-user {{user && item.id === user.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSwitchUser"
      >
        <text>{{item.name}}</text>
        <text class="muted role">{{item.role === 'super_admin' ? t.t('mine.dev_role_admin', lang) : item.role === 'class_admin' ? '班管' : t.t('mine.dev_role_user', lang)}}</text>
      </view>
    </view>
    <view class="dev-row" bindtap="resetOnboarding">{{t.t('mine.dev_reset_onboard', lang)}}</view>
  </view>
  <button wx:if="{{user && !isGuest}}" class="logout-button" bindtap="signOut">退出登录</button>
</view>
