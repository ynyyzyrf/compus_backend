.mine-page {
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 40rpx;
}
.profile-header.has-notice {
  border-radius: 48rpx 48rpx 0 0;
  background: linear-gradient(180deg, #b23d37 0%, #ce756e 50%, #e5b6b2 100%);
}
.pending-notice {
  padding: 24rpx 32rpx 0;
  color: #fff;
}
.pending-notice-pill {
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.12);
}
.pending-notice-icon { flex: 0 0 auto; }
.pending-notice-title { flex: 0 0 auto; font-size: 28rpx; font-weight: 600; white-space: nowrap; }
.pending-notice-divider { flex: 0 0 auto; width: 2rpx; height: 28rpx; background: rgba(255, 255, 255, 0.45); }
.pending-notice-path { display: block; flex: 1; min-width: 0; font-size: 24rpx; color: rgba(255, 255, 255, 0.8); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-hero {
  min-height: 180rpx;
  box-sizing: border-box;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(180deg, #c83a34 0%, #e5b6b2 100%);
  color: #fff;
}
.profile-hero.has-notice { min-height: 0; padding: 40rpx 32rpx 42rpx; background: transparent; }
.guest-login-hit {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-radius: 18rpx;
}
.guest-login-hit.active {
  cursor: pointer;
}
.avatar.big {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: #f0f0f0;
  color: #c12d27;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  flex: 0 0 auto;
}
.hero-info {
  flex: 1;
  min-width: 0;
}
.name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.login-name {
  font-size: 30rpx;
  font-weight: 800;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}
.badge {
  font-size: 20rpx;
  color: #7b2a13;
  background: #f4dfae;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}
.profile-pill {
  flex: 0 0 auto;
  height: 72rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  font-weight: 800;
}
.service-card,
.menu-card,
.dev {
  margin: 24rpx 28rpx 0;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 10rpx 28rpx rgba(126, 40, 34, 0.06);
}
.service-card {
  padding: 28rpx 28rpx 22rpx;
}
.section-title {
  color: #333;
  font-size: 30rpx;
  font-weight: 900;
  margin-bottom: 24rpx;
}
.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 30rpx;
}
.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  color: #333;
  font-size: 24rpx;
  font-weight: 700;
  min-width: 0;
}
.service-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #cf342c, #a91f1b);
}
.service-item:nth-child(2) .service-icon {
  background: linear-gradient(135deg, #d7aa44, #bf8426);
}
.service-item:nth-child(3) .service-icon {
  background: linear-gradient(135deg, #c9443d, #8f2d27);
}
.service-item:nth-child(4) .service-icon {
  background: linear-gradient(135deg, #deb95d, #c4932b);
}
.service-item:nth-child(5) .service-icon {
  background: linear-gradient(135deg, #bf2e29, #8e1f1b);
}
.service-item:nth-child(6) .service-icon {
  background: linear-gradient(135deg, #e4c66e, #b68529);
}
.menu-card {
  padding: 0 28rpx;
}
.menu-item {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #ececec;
  color: #333;
  font-size: 28rpx;
}
.menu-item:last-child {
  border-bottom: 0;
}
.arrow {
  color: #777;
}
.muted {
  color: #888;
}
.lang-label {
  margin-left: auto;
  margin-right: 12rpx;
  font-size: 24rpx;
}
.dev {
  padding: 28rpx;
}
.dev-title {
  font-weight: 700;
  font-size: 28rpx;
}
.dev-tip {
  font-size: 22rpx;
  margin: 10rpx 0 20rpx;
  line-height: 1.5;
}
.dev-users {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.dev-user {
  display: flex;
  align-items: center;
  gap: 10rpx;
  border: 1rpx solid #ead4c6;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}
.dev-user.on {
  background: #b92722;
  border-color: #b92722;
  color: #fff;
}
.dev-user .role {
  font-size: 20rpx;
}
.dev-row {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #ececec;
  font-size: 26rpx;
  color: #333;
}
