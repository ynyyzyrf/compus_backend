<view class="page-pad">
  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />
  <t-empty wx:elif="{{!activity}}" description="活动不存在" />

  <block wx:elif="{{activity}}">
    <view class="hero">
      <image class="hero-img" src="/assets/campus-hero.jpg" mode="aspectFill" />
      <view class="hero-mask"></view>
      <view class="hero-copy">
        <view class="title">{{activity.title}}</view>
        <view class="muted-light">{{activity.organizer || '校友商会'}}</view>
      </view>
    </view>

    <view class="card">
      <view class="line"><text class="lbl">时间</text><text>{{activity.dateText}} - {{activity.endText}}</text></view>
      <view class="line"><text class="lbl">地点</text><text>{{activity.location}}</text></view>
      <view class="line"><text class="lbl">报名截止</text><text>{{activity.signupEndText}}</text></view>
      <view class="line">
        <text class="lbl">名额</text>
        <text>{{activity.capacity ? activity.signup_count + ' / ' + activity.capacity : activity.signup_count + ' 已报名'}}</text>
      </view>
      <view wx:if="{{activity.checkin_count > 0}}" class="line">
        <text class="lbl">签到</text>
        <text>{{activity.checkin_count}} 人</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">活动介绍</view>
      <view class="desc">{{activity.description || '暂无介绍'}}</view>
    </view>

    <view class="quick-row">
      <view class="quick-action" bindtap="goAlbum">
        <view class="qa-icon">相</view>
        <view class="qa-title">活动相册</view>
        <view class="qa-sub">查看与投稿照片</view>
      </view>
      <view class="quick-action" bindtap="goPoster">
        <view class="qa-icon blue">海</view>
        <view class="qa-title">分享海报</view>
        <view class="qa-sub">生成保存到相册</view>
      </view>
    </view>

    <view wx:if="{{activity.my_checked_in}}" class="status-tag status-ok">
      ✓ 您已签到
    </view>
    <view wx:elif="{{activity.my_signed_up}}" class="status-tag status-signed">
      ✓ 您已报名
    </view>

    <view class="actions">
      <t-button
        wx:if="{{!activity.my_signed_up && !activity.my_checked_in}}"
        theme="primary"
        size="large"
        block
        bindtap="openSignupSheet"
      >立即报名</t-button>
      <t-button
        wx:if="{{activity.my_signed_up && !activity.my_checked_in}}"
        theme="default"
        variant="outline"
        size="large"
        block
        bindtap="onCancelSignup"
      >取消报名</t-button>
      <t-button
        wx:if="{{activity.my_signed_up}}"
        theme="success"
        size="large"
        block
        bindtap="openCheckinSheet"
      >扫码签到</t-button>
    </view>

    <!-- bottom sheet -->
    <view wx:if="{{sheetOpen}}" class="sheet-mask" bindtap="closeSheet">
      <view class="sheet" catchtap="noop">
        <view class="grab"></view>

        <block wx:if="{{sheetMode === 'signup'}}">
          <view class="sheet-title">活动报名</view>
          <view class="field">
            <view class="lbl2">手机号</view>
            <input class="native-input" value="{{phone}}" placeholder="13800000000" bindinput="onPhone" maxlength="32" />
          </view>
          <view class="field">
            <view class="lbl2">备注</view>
            <input class="native-input" value="{{remark}}" placeholder="选填" bindinput="onRemark" maxlength="500" />
          </view>
          <t-button theme="primary" size="large" loading="{{submitting}}" block bindtap="onConfirmSignup">确认报名</t-button>
        </block>

        <block wx:elif="{{sheetMode === 'checkin'}}">
          <view class="sheet-title">扫码签到</view>
          <view class="muted small">请让管理员出示活动签到码，或粘贴 token</view>
          <view class="field">
            <view class="lbl2">签到 token</view>
            <input class="native-input" value="{{scanToken}}" placeholder="扫码后自动填入" bindinput="onScanToken" />
          </view>
          <t-button theme="default" variant="outline" size="large" block bindtap="onScanCode">打开扫一扫</t-button>
          <view style="height: 24rpx"></view>
          <t-button theme="success" size="large" loading="{{submitting}}" block bindtap="onConfirmCheckin">确认签到</t-button>
        </block>
      </view>
    </view>
  </block>
</view>
