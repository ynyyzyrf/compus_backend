.hero {
  position: relative;
  height: 330rpx;
  border-radius: 24rpx;
  color: #fff;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 44rpx rgba(185, 39, 34, 0.18);
}
.hero-img,
.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
.hero-mask {
  background: linear-gradient(0deg, rgba(8, 21, 42, 0.76), rgba(8, 21, 42, 0.08));
}
.hero-copy {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 30rpx;
  z-index: 1;
}
.hero .title {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
  margin-bottom: 8rpx;
}
.muted-light { color: rgba(255, 255, 255, 0.85); font-size: 24rpx; }

.card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}
.card-title { font-weight: 800; margin-bottom: 16rpx; }
.line {
  display: flex;
  gap: 24rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid var(--line);
}
.line:last-child { border-bottom: 0; }
.lbl { width: 140rpx; color: var(--muted); flex: 0 0 auto; }
.desc { font-size: 28rpx; line-height: 1.7; color: var(--ink); white-space: pre-wrap; }

.quick-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-bottom: 24rpx;
}
.quick-action {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: var(--shadow);
}
.qa-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #fff4e1;
  color: #b92722;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  margin-bottom: 14rpx;
}
.qa-icon.blue { background: #f7e8bd; color: #8f1f1a; }
.qa-title { font-weight: 800; color: var(--ink); }
.qa-sub { color: var(--muted); font-size: 22rpx; margin-top: 6rpx; }

.status-tag {
  text-align: center;
  padding: 20rpx;
  border-radius: 18rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.status-ok { background: #eafaf4; color: #20a873; }
.status-signed { background: #fff4e1; color: #8f6b28; }

.actions { display: flex; flex-direction: column; gap: 20rpx; }

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(12, 16, 20, 0.45);
  z-index: 60;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 32rpx 40rpx;
}
.grab {
  width: 80rpx;
  height: 8rpx;
  background: #dce1e5;
  border-radius: 999rpx;
  margin: 0 auto 24rpx;
}
.sheet-title { font-size: 32rpx; font-weight: 800; margin-bottom: 24rpx; }
.field { margin-bottom: 24rpx; }
.lbl2 { font-size: 24rpx; color: var(--muted); margin-bottom: 12rpx; }
.muted { color: var(--muted); }
.small { font-size: 24rpx; margin-bottom: 20rpx; }
