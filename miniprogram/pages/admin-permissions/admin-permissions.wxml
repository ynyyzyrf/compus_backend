<wxs src="../../utils/i18n.wxs" module="t" />
<view class="page-pad">
  <view class="intro card">
    <view class="title">{{t.t('admin.permissions.title', lang)}}</view>
    <view class="muted small">{{t.t('admin.permissions.desc', lang)}}</view>
  </view>

  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />

  <view wx:else class="list">
    <view
      class="item"
      wx:for="{{items}}"
      wx:key="organization_id"
    >
      <view class="row">
        <t-tag theme="primary" variant="light" size="small">{{item.scopeLabel}}</t-tag>
        <text class="name">{{item.organization_name}}</text>
        <t-switch
          checked="{{item.is_enabled}}"
          data-index="{{index}}"
          bind:change="onToggle"
        />
      </view>
    </view>
  </view>
</view>
