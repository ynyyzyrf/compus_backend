.intro .title {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
  color: var(--ink);
}
.label {
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
  color: var(--ink);
}
.label-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}
.field {
  margin-bottom: 24rpx;
}
.readonly {
  font-size: 30rpx;
  color: var(--ink);
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #f6f8fc;
}
.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 40rpx;
}
