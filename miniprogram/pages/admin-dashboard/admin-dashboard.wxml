<wxs src="../../utils/i18n.wxs" module="t" />
<view class="page-pad">
  <text class="page-title">{{t.t('admin.dashboard.title', lang)}}</text>

  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />

  <block wx:elif="{{stats}}">
    <view class="stats-grid">
      <view class="stat">
        <text class="big">{{stats.active_member_total}}</text>
        <text class="muted">{{t.t('admin.dashboard.active_members', lang)}}</text>
      </view>
      <view class="stat">
        <text class="big">{{stats.signing_activity_total + stats.ongoing_activity_total}}</text>
        <text class="muted">{{t.t('admin.dashboard.active_activities', lang)}}</text>
      </view>
      <view class="stat">
        <text class="big">{{stats.recent_checkin_rate * 100}}%</text>
        <text class="muted">{{t.t('admin.dashboard.recent_checkin_rate', lang)}}</text>
      </view>
    </view>

    <view class="org-strip">
      <text>{{stats.college_count}} {{t.t('admin.dashboard.college_unit', lang)}}</text>
      <text class="dot">·</text>
      <text>{{stats.department_count}} {{t.t('admin.dashboard.department_unit', lang)}}</text>
      <text class="dot">·</text>
      <text>{{stats.class_count}} {{t.t('admin.dashboard.class_unit', lang)}}</text>
    </view>

    <view class="section-title"><text class="t">{{t.t('admin.dashboard.content_section', lang)}}</text></view>
    <view class="admin-grid">
      <view class="admin-card" bindtap="goActivities"><view class="ac-ico">📅</view><view class="ac-title">{{t.t('admin.dashboard.activities', lang)}}</view><view class="muted">{{t.t('admin.dashboard.activities_sub', lang)}}</view></view>
      <view class="admin-card" bindtap="goArticles"><view class="ac-ico">📣</view><view class="ac-title">{{t.t('admin.dashboard.articles', lang)}}</view><view class="muted">{{t.t('admin.dashboard.articles_sub', lang)}}</view></view>
      <view class="admin-card" bindtap="goRelays"><view class="ac-ico">🧩</view><view class="ac-title">{{t.t('admin.dashboard.relays', lang)}}</view><view class="muted">{{t.t('relays.results', lang)}}</view></view>
      <view class="admin-card" bindtap="goPhotos"><view class="ac-ico">🖼</view><view class="ac-title">{{t.t('admin.dashboard.albums', lang)}}</view><view class="muted">{{t.t('photos.admin.title', lang)}}</view></view>
    </view>

    <view class="section-title"><text class="t">{{t.t('admin.dashboard.org_section', lang)}}</text></view>
    <view class="admin-grid">
      <view class="admin-card" bindtap="goMembers"><view class="ac-ico">👥</view><view class="ac-title">{{t.t('admin.dashboard.members', lang)}}</view><view class="muted">{{t.t('admin.dashboard.members_sub', lang)}}</view></view>
      <view class="admin-card" bindtap="goOrgs"><view class="ac-ico">🏫</view><view class="ac-title">{{t.t('admin.dashboard.orgs', lang)}}</view><view class="muted">{{t.t('admin.dashboard.orgs_sub', lang)}}</view></view>
      <view class="admin-card" bindtap="goPermissions"><view class="ac-ico">🔐</view><view class="ac-title">{{t.t('admin.dashboard.permissions', lang)}}</view><view class="muted">{{t.t('admin.dashboard.permissions_sub', lang)}}</view></view>
      <view class="admin-card" bindtap="goAi"><view class="ac-ico">✦</view><view class="ac-title">{{t.t('admin.dashboard.ai', lang)}}</view><view class="muted">{{t.t('ai.title', lang)}}</view></view>
    </view>
  </block>
</view>
