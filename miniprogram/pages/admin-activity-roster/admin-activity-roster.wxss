.stats {
  display: flex;
  justify-content: space-around;
  text-align: center;
}
.stat { display: flex; flex-direction: column; gap: 8rpx; }
.big { font-size: 40rpx; font-weight: 800; color: var(--brand); }
.title { font-weight: 700; margin-bottom: 12rpx; }
.college-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
}
.list { display: flex; flex-direction: column; gap: 16rpx; }
.row {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(20, 29, 38, 0.04);
}
.row-main { flex: 1; min-width: 0; }
.row-name { font-size: 28rpx; font-weight: 700; }
.row-side { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.phone { font-size: 24rpx; color: var(--brand); }
.small { font-size: 22rpx; }
