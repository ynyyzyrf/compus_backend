.settings-page { min-height: 100vh; padding: 20px 16px 32px; padding-bottom: calc(32px + env(safe-area-inset-bottom)); background: var(--bg); }
.discovery-card { display: flex; align-items: center; gap: 8px; min-height: 56px; padding: 14px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
.discovery-label { flex: 1; min-width: 0; color: var(--ink); font-size: 14px; line-height: 1.5; }
.discovery-status { flex: none; color: var(--muted); font-size: 12px; white-space: nowrap; }
.discovery-arrow { flex: none; color: var(--muted); }
.saving-status { padding: 14px 0; color: var(--muted); font-size: 12px; text-align: center; }
.settings-state { padding: 48px 12px; color: var(--muted); font-size: 14px; line-height: 1.6; text-align: center; }
.retry-button { margin-top: 20px; }
