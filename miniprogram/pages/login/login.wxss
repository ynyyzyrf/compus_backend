.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 230rpx 48rpx 48rpx;
  background: #fff;
}
.brand-space {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.logo-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 84rpx;
}
.seal,
.mini-seal {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #d9a94b, #a82020 72%);
  color: #ffe9b7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
}
.logo-text {
  color: #17633e;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
}
.logo-text text {
  display: block;
  color: #17633e;
  font-size: 12rpx;
  font-weight: 500;
}
.title {
  font-size: 42rpx;
  font-weight: 900;
  color: #333;
  letter-spacing: 0;
}
.subtitle {
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.7;
  margin-bottom: 64rpx;
}
.login-page .t-button {
  --td-button-primary-bg-color: #e9e2b1;
  --td-button-primary-border-color: #e9e2b1;
  --td-button-primary-color: #333;
  border-radius: 18rpx;
}
.skip-login {
  margin-top: 28rpx;
  text-align: center;
  color: #8f6b28;
  font-size: 28rpx;
  font-weight: 800;
}
.dev-tip {
  margin-top: 28rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.32);
  display: flex;
  align-items: flex-end;
  z-index: 80;
}
.phone-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 56rpx 48rpx 70rpx;
  border-radius: 26rpx 26rpx 0 0;
  background: #f8f8f8;
}
.sheet-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.mini-seal {
  width: 46rpx;
  height: 46rpx;
  font-size: 20rpx;
}
.sheet-org {
  flex: 1;
  font-size: 30rpx;
  font-weight: 900;
}
.info-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #c8c8c8;
  color: #aaa;
  font-weight: 800;
  text-align: center;
  line-height: 34rpx;
}
.sheet-title {
  margin-top: 32rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #111;
}
.sheet-sub {
  margin-top: 10rpx;
  color: #888;
  font-size: 28rpx;
}
.phone-card,
.deny {
  margin-top: 44rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.phone-auth-button {
  width: 100%;
  height: 108rpx;
  line-height: 108rpx;
  border: 0;
  border-radius: 16rpx;
  background: #17633e;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}
.phone-auth-button::after { border: 0; }
.deny {
  height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  font-size: 34rpx;
  color: #222;
}
