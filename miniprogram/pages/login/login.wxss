page {
  background: #fcf7ef;
}

.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #fcf7ef;
}

.campus-photo {
  display: block;
  flex: none;
  width: 100%;
  height: 47vh;
  min-height: 340rpx;
  max-height: 760rpx;
  background: #e0dccb;
}

.login-body {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-top: -44rpx;
  padding: 42rpx 52rpx 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 44rpx 44rpx 0 0;
  background: #fcf7ef;
}

.brand-signature {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  color: #832f27;
  font-size: 28rpx;
  font-weight: 700;
}

.brand-seal {
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  border-radius: 10rpx;
  background: #9a3429;
  color: #fbe5b6;
  font-size: 28rpx;
  font-weight: 800;
}

.welcome-title {
  color: #261c18;
  font-size: 68rpx;
  font-weight: 800;
  line-height: 1.14;
}

.welcome-description {
  margin-top: 16rpx;
  color: #6d5548;
  font-size: 28rpx;
  line-height: 1.6;
}

.login-actions {
  margin-top: auto;
  padding-top: 44rpx;
}

.login-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  border: 0;
  font-size: 30rpx;
  line-height: 1.3;
}

.login-primary::after {
  border: 0;
}

.login-primary {
  gap: 16rpx;
  width: 100% !important;
  max-width: none;
  min-height: 106rpx;
  padding: 22rpx 28rpx;
  border-radius: 18rpx;
  background: #ab2e25;
  color: #fff;
  font-weight: 700;
}

.login-primary-pressed {
  background: #8f241d;
}

@media (max-height: 570px) {
  .campus-photo {
    height: 38vh;
    min-height: 240rpx;
  }

  .login-body {
    padding-top: 32rpx;
  }

  .login-actions {
    padding-top: 32rpx;
  }
}
