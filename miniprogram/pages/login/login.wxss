.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 230rpx 48rpx 48rpx;
  background: #fff;
}
.brand-space {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.logo-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 84rpx;
}
.seal {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #d9a94b, #a82020 72%);
  color: #ffe9b7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
}
.logo-text {
  color: #17633e;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
}
.logo-text text {
  display: block;
  color: #17633e;
  font-size: 12rpx;
  font-weight: 500;
}
.title {
  font-size: 42rpx;
  font-weight: 900;
  color: #333;
  letter-spacing: 0;
}
.subtitle {
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.7;
  margin-bottom: 64rpx;
}
.login-page .t-button {
  --td-button-primary-bg-color: #e9e2b1;
  --td-button-primary-border-color: #e9e2b1;
  --td-button-primary-color: #333;
  border-radius: 18rpx;
}
.skip-login {
  margin-top: 28rpx;
  text-align: center;
  color: #8f6b28;
  font-size: 28rpx;
  font-weight: 800;
}
.dev-tip {
  margin-top: 28rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}
