<view class="page-pad">
  <view class="page-title">{{title}}</view>
  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />
  <t-empty wx:elif="{{rows.length === 0}}" description="{{empty}}" />

  <view wx:else class="list">
    <view wx:for="{{rows}}" wx:key="id" class="upload-card">
      <image class="thumb" src="{{item.file_url}}" mode="aspectFill" />
      <view class="meta">
        <view class="name">#{{item.id}}</view>
        <view class="muted">{{item.created_at}}</view>
      </view>
      <view class="status {{item.status}}">{{item.statusText}}</view>
    </view>
  </view>
</view>
