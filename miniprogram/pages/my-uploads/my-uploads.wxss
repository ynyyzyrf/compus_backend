.page-title { font-size: 40rpx; font-weight: 900; margin-bottom: 24rpx; }
.list { display: flex; flex-direction: column; gap: 18rpx; }
.upload-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  box-shadow: var(--shadow);
}
.thumb {
  width: 118rpx;
  height: 118rpx;
  border-radius: 16rpx;
  background: #eaf1fb;
  flex: 0 0 auto;
}
.meta { flex: 1; min-width: 0; }
.name { font-weight: 800; }
.muted { color: var(--muted); font-size: 22rpx; margin-top: 8rpx; }
.status { font-size: 22rpx; padding: 8rpx 14rpx; border-radius: 999rpx; }
.pending { color: #bb6400; background: #fff4df; }
.approved { color: #168a5b; background: #eafaf4; }
.rejected { color: #c63c3c; background: #fff0f0; }
