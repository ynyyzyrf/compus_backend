<view class="page-pad">
  <view wx:if="{{loading}}" class="card">载入中...</view>
  <view wx:elif="{{error}}" class="card"><text>{{error}}</text><button bindtap="load">重试</button></view>
  <view wx:elif="{{!items.length}}" class="card">暂无待审核申请</view>
  <view wx:else>
    <view wx:for="{{items}}" wx:key="user_id" class="card">
      <view class="name">{{item.name}}</view>
      <view wx:if="{{item.verified_phone}}" class="muted">{{item.verified_phone}}</view>
      <view class="path">{{item.org_path}}</view>
      <view class="actions">
        <button data-id="{{item.user_id}}" bindtap="reject" disabled="{{busyId !== 0}}">退回</button>
        <button class="approve" data-id="{{item.user_id}}" bindtap="approve" disabled="{{busyId !== 0}}">通过</button>
      </view>
    </view>
  </view>
  <view wx:if="{{!loading && !error && missing.length}}" class="card intro">找不到班级的反馈</view>
  <view wx:if="{{!loading && !error}}" wx:for="{{missing}}" wx:key="user_id" class="card">
    <view class="name">{{item.name}}</view>
    <view class="path">{{item.note}}</view>
    <button data-id="{{item.user_id}}" bindtap="resolve" disabled="{{busyId !== 0}}">标记已处理</button>
  </view>
</view>
