.administrators-page { box-sizing: border-box; width: 100%; min-width: 0; min-height: 100vh; padding: 16px 16px 32px; padding-bottom: calc(32px + env(safe-area-inset-bottom)); background: var(--bg); }
.class-name { font-size: 20px; font-weight: 600; color: var(--ink); line-height: 1.5; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 20px 0 10px; font-size: 15px; font-weight: 600; color: var(--ink); }
.count { font-size: 12px; color: var(--muted); font-weight: 400; }
.people-list { padding: 0 12px; border-radius: 12px; background: var(--card); }
.person-row { display: flex; align-items: center; gap: 12px; min-height: 72px; padding: 12px 0; border-bottom: 1px solid var(--line); }
.person-row:last-child { border-bottom: 0; }
.person-copy, .person-row > .person-name { flex: 1 1 0%; min-width: 0; }
.person-name { overflow: hidden; font-size: 15px; line-height: 22px; color: var(--ink); text-overflow: ellipsis; white-space: nowrap; }
.person-org { display: -webkit-box; overflow: hidden; max-height: 36px; margin-top: 4px; font-size: 12px; color: var(--muted); line-height: 18px; word-break: break-word; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
button.text-action { display: flex; align-items: center; justify-content: center; flex: 0 0 52px; width: 52px !important; min-width: 52px; max-width: 52px; height: 44px; min-height: 44px; margin: 0; padding: 0; box-sizing: border-box; border: 0; border-radius: 6px; background: transparent; color: var(--brand); font-size: 13px; font-weight: 500; line-height: 1.5; }
.text-action::after { border: 0; }
button.text-action[disabled] { background: transparent; color: var(--muted); }
.search-bar { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; padding: 0 4px 0 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
.search-bar .text-action { border-left: 1px solid var(--line); border-radius: 0; }
.search-input { flex: 1; min-width: 0; height: 48px; background: transparent; color: var(--ink); font-size: 14px; }
.state { padding: 16px 8px; color: var(--muted); font-size: 13px; line-height: 1.5; text-align: center; }
.more-button { width: 100% !important; min-height: 44px; margin: 16px 0 0; color: var(--brand); font-size: 13px; }
