<wxs src="../../utils/i18n.wxs" module="t" />
<view class="page-pad">
  <view class="head">
    <text class="title">{{t.t('relays.admin_title', lang)}}</text>
    <t-button theme="primary" size="small" bindtap="onNew">＋ {{t.t('relays.new', lang)}}</t-button>
  </view>

  <t-loading wx:if="{{loading}}" theme="circular" size="40rpx" />
  <t-empty wx:elif="{{items.length === 0}}" description="{{t.t('relays.empty', lang)}}" />

  <view wx:else class="list">
    <view class="item" wx:for="{{items}}" wx:key="id">
      <view class="row1">
        <view class="title2">{{item.title}}</view>
        <t-tag theme="{{item.status === 'open' ? 'success' : 'default'}}" variant="light" size="small">{{item.statusText}}</t-tag>
      </view>
      <view class="row2">
        <text>{{item.responseText}}</text>
        <text wx:if="{{item.deadlineText}}">{{t.t('relays.deadline', lang)}} {{item.deadlineText}}</text>
      </view>
      <view class="row3">
        <view class="action" data-id="{{item.id}}" bindtap="onResponses">{{t.t('relays.results', lang)}}</view>
        <view class="action" data-id="{{item.id}}" bindtap="onEdit">{{t.t('common.edit', lang)}}</view>
        <view class="action danger" data-id="{{item.id}}" bindtap="onDelete">{{t.t('common.delete', lang)}}</view>
      </view>
    </view>
  </view>
</view>
