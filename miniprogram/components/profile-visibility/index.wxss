.visibility-card { padding: 24rpx; margin-bottom: 24rpx; border-radius: 16rpx; background: var(--card, #fff); border: 1rpx solid var(--line, #efe4dc); }
.visibility-title { font-size: 30rpx; font-weight: 700; }
.visibility-desc { font-size: 24rpx; margin: 8rpx 0 12rpx; color: var(--muted, #7d6f68); }
.visibility-row { min-height: 80rpx; display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid var(--line, #efe4dc); }
.audience { color: var(--brand, #b92722); font-size: 26rpx; }
