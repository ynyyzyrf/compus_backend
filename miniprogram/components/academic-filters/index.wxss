.filters { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 0; }
.filter { max-width: 580rpx; padding: 12rpx 20rpx; border-radius: 14rpx; background: #f1f2f4; color: #3b3c43; font-size: 24rpx; }
.filter.selected { background: #faeae7; color: #a92722; }
.compact {
  gap: 0 8rpx;
  margin: 6rpx 0 0;
  border-bottom: 1rpx solid var(--line, #efe4dc);
}
.compact .filter-picker { max-width: 100%; min-width: 0; }
.compact .filter {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 68rpx;
  padding: 0 12rpx;
  border-radius: 0;
  background: transparent;
  color: var(--muted, #7d6f68);
  font-size: 25rpx;
}
.compact .filter.selected { color: var(--brand, #b92722); font-weight: 600; }
.compact .filter-label { max-width: 245rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.compact .filter-arrow { flex: none; }
.tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin: 24rpx 0; }
.tiles .filter-picker { min-width: 0; }
.tiles .filter { display: flex; align-items: center; justify-content: center; gap: 6rpx; min-height: 44px; padding: 16rpx 12rpx; background: #ece7e1; color: #54453c; font-size: 25rpx; }
.tiles .filter-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tiles .filter-arrow { flex: none; }
.tiles .filter.selected { background: #f5e2dd; color: var(--brand, #b92722); }
