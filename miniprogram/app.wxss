/* ===== TDesign 品牌主題覆蓋（圆螺岭同学录紅金） ===== */
page {
  /* TDesign 主題變量 */
  --td-brand-color: #92392c;
  --td-brand-color-light: #f2e7dd;
  --td-brand-color-focus: #7b3025;
  --td-warning-color: #d7aa44;
  --td-error-color: #f04b4b;

  /* 圆螺岭同学录：温暖校园色板 */
  --brand: #92392c;
  --brand-2: #7b3025;
  --brand-soft: #f2e7dd;
  --gold: #d7aa44;
  --gold-soft: #f7e8bd;
  --cyan: #55b9c6;
  --mint: #45b986;
  --amber: #d7aa44;
  --ink: #332820;
  --muted: #948679;
  --subtle: #ad9f91;
  --line: #e9e0d5;
  --bg: #f6f2eb;
  --card: #fffcf8;
  --shadow: none;

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei',
    sans-serif;
}

view,
text,
button {
  box-sizing: border-box;
}

.page-pad {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 100vh;
  padding: 28rpx 24rpx 144rpx;
  padding-bottom: calc(144rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(239, 228, 220, 0.95);
  box-shadow: var(--shadow);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 4rpx 20rpx;
}
.section-title .t {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0;
}
.section-title .more {
  font-size: 24rpx;
  color: var(--muted);
}

.muted {
  color: var(--muted);
}

.page-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 0;
  margin-bottom: 20rpx;
}

.pill-tabs {
  display: flex;
  gap: 18rpx;
  margin: 20rpx 0 24rpx;
  overflow: hidden;
}

.pill-tab {
  min-width: 108rpx;
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  color: var(--muted);
  background: rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
}

.pill-tab.on {
  color: #fff;
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  box-shadow: 0 10rpx 24rpx rgba(185, 39, 34, 0.24);
}
