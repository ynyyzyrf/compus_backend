/* ===== TDesign 品牌主題覆蓋（校友商會紅金） ===== */
page {
  /* TDesign 主題變量 */
  --td-brand-color: #b92722;
  --td-brand-color-light: #fff4e1;
  --td-brand-color-focus: #8f1f1a;
  --td-warning-color: #d7aa44;
  --td-error-color: #f04b4b;

  /* 業務色板（紅金商會主題） */
  --brand: #b92722;
  --brand-2: #8f1f1a;
  --brand-soft: #fff4e1;
  --gold: #d7aa44;
  --gold-soft: #f7e8bd;
  --cyan: #55b9c6;
  --mint: #45b986;
  --amber: #d7aa44;
  --ink: #111827;
  --muted: #7d6f68;
  --subtle: #aa9b91;
  --line: #efe4dc;
  --bg: #f7f3ef;
  --card: #ffffff;
  --shadow: 0 14rpx 42rpx rgba(126, 40, 34, 0.08);

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei',
    sans-serif;
}

view,
text,
button {
  box-sizing: border-box;
}

.page-pad {
  min-height: 100vh;
  padding: 28rpx 24rpx 144rpx;
  background:
    radial-gradient(circle at 0 0, rgba(185, 39, 34, 0.1), transparent 360rpx),
    linear-gradient(180deg, #fff9f1 0%, #f7f3ef 42%, #f8f5f1 100%);
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(239, 228, 220, 0.95);
  box-shadow: var(--shadow);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 4rpx 20rpx;
}
.section-title .t {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0;
}
.section-title .more {
  font-size: 24rpx;
  color: var(--muted);
}

.muted {
  color: var(--muted);
}

.page-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 0;
  margin-bottom: 20rpx;
}

.pill-tabs {
  display: flex;
  gap: 18rpx;
  margin: 20rpx 0 24rpx;
  overflow: hidden;
}

.pill-tab {
  min-width: 108rpx;
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  color: var(--muted);
  background: rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
}

.pill-tab.on {
  color: #fff;
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  box-shadow: 0 10rpx 24rpx rgba(185, 39, 34, 0.24);
}
